---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { authors, initials } from '../../data/authors';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const url = new URL(`/blog/${post.id}`, Astro.site).toString();
const fmt = (x: Date) => x.toLocaleDateString('sr-Latn-RS', { day: 'numeric', month: 'long', year: 'numeric' });
const others = (await getCollection('blog')).filter((p) => p.id !== post.id).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const toc = headings.filter((h) => h.depth === 2);
const a = authors[d.author];
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description,
    datePublished: d.date.toISOString(), dateModified: (d.updated || d.date).toISOString(), inLanguage: 'sr-Latn',
    mainEntityOfPage: url, keywords: d.keywords.join(', '), articleSection: d.category,
    image: d.image ? new URL(d.image, Astro.site).toString() : undefined,
    author: { '@type': 'Person', name: d.author, worksFor: { '@type': 'Organization', name: site.name } },
    publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: new URL('/img/logo.png', Astro.site).toString() } },
  },
  d.faq.length && { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Početna', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ] },
].filter(Boolean);
---
<Base title={d.title} description={d.description} image={d.image}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(ld)} /><meta property="og:type" content="article" /><meta name="author" content={d.author} /><meta name="keywords" content={d.keywords.join(', ')} /></Fragment>
  <article class="art">
    <header class="wrap art__head">
      <nav class="crumbs" aria-label="Putanja"><a href="/">Početna</a> / <a href="/blog">Blog</a> / <span>{d.category}</span></nav>
      <h1>{d.title}</h1>
      <p class="art__lead">{d.description}</p>
      <div class="art__meta"><span class="av">{initials(d.author)}</span><div><b>{d.author}</b><br /><span>{fmt(d.date)}{d.readingTime && ` · ${d.readingTime} min čitanja`}</span></div></div>
    </header>
    {d.image && <div class="wrap"><img class="art__cover" src={d.image} alt={d.title} /></div>}
    <div class="wrap art__grid">
      <aside class="toc">
        {toc.length > 2 && <div><b>Sadržaj</b><ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></div>}
        <a href="/#upit" class="btn btn--primary">Pošaljite upit</a>
      </aside>
      <div class="prose">
        <Content />
        {d.faq.length > 0 && (
          <section class="faq">
            <h2 id="cesta-pitanja">Česta pitanja</h2>
            {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </section>
        )}
        <div class="author card"><span class="av av--lg">{initials(d.author)}</span><div><b>{d.author}</b> · {a?.role}<p>{a?.bio}</p></div></div>
        <div class="cta card"><div><h3>Planirate događaj za decu zaposlenih?</h3><p>Javite nam datum i broj dece — u roku od {site.responseTime} šaljemo predlog programa i ponudu.</p></div><a href="/#upit" class="btn btn--primary">Pošaljite upit</a></div>
      </div>
    </div>
    {others.length > 0 && (
      <section class="section section--alt"><div class="wrap"><h2>Pročitajte i</h2>
        <div class="more">{others.map((p) => <a href={`/blog/${p.id}`} class="more__item card"><span class="chip">{p.data.category}</span><h3>{p.data.title}</h3><span class="muted">{p.data.author}</span></a>)}</div>
      </div></section>
    )}
  </article>
</Base>
<style>
  .art__head { max-width: 860px; padding-top: 48px; }
  .crumbs { font-size: .88rem; color: var(--ink-3); margin-bottom: 18px; } .crumbs a { color: var(--ink-3); }
  .art__lead { font-size: 1.15rem; color: var(--ink-2); }
  .art__meta { display: flex; gap: 12px; align-items: center; margin: 22px 0 28px; color: var(--ink-3); font-size: .92rem; } .art__meta b { color: var(--ink); }
  .av { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--brand); color: #fff; font-weight: 900; flex: none; }
  .av--lg { width: 56px; height: 56px; font-size: 1.1rem; }
  .art__cover { width: 100%; max-height: 520px; object-fit: cover; border-radius: 24px; }
  .art__grid { display: grid; grid-template-columns: 260px minmax(0, 760px); gap: 48px; padding-top: 40px; padding-bottom: 72px; justify-content: center; }
  .toc { position: sticky; top: 100px; align-self: start; display: grid; gap: 18px; font-size: .92rem; }
  .toc ol { padding-left: 18px; margin: 8px 0 0; display: grid; gap: 6px; } .toc a { color: var(--ink-2); text-decoration: none; } .toc a:hover { color: var(--brand); }
  .prose { font-size: 1.08rem; line-height: 1.75; min-width: 0; overflow-wrap: break-word; }
  .prose :global(h2) { font-size: 1.6rem; margin: 2em 0 .6em; scroll-margin-top: 90px; }
  .prose :global(h3) { font-size: 1.22rem; margin: 1.6em 0 .5em; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; } .prose :global(li) { margin: .35em 0; }
  .prose :global(table) { width: 100%; max-width: 100%; border-collapse: collapse; margin: 1.5em 0; font-size: .96rem; display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .prose :global(img) { max-width: 100%; height: auto; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--line); padding: 10px 12px; text-align: left; vertical-align: top; }
  .prose :global(th) { background: var(--surface-2); }
  .prose :global(blockquote) { margin: 1.5em 0; padding: 14px 20px; border-left: 4px solid var(--orange); background: var(--tint-orange); border-radius: 0 12px 12px 0; }
  .prose :global(a) { font-weight: 700; }
  .faq { margin-top: 2.5em; } .faq details { border-bottom: 1px solid var(--line); padding: 14px 0; } .faq summary { font-weight: 800; cursor: pointer; } .faq p { margin: 10px 0 0; color: var(--ink-2); }
  .author { display: flex; gap: 16px; align-items: flex-start; margin-top: 40px; } .author p { margin: 6px 0 0; color: var(--ink-2); font-size: .96rem; }
  .cta { margin-top: 20px; display: flex; gap: 18px; align-items: center; justify-content: space-between; flex-wrap: wrap; background: var(--tint-blue); border-color: transparent; }
  .cta h3 { margin: 0 0 4px; } .cta p { margin: 0; font-size: .98rem; color: var(--ink-2); }
  .more { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 16px; }
  .more__item { text-decoration: none; color: inherit; display: grid; gap: 8px; } .more__item h3 { margin: 0; } .muted { color: var(--ink-3); font-size: .9rem; }
  @media (max-width: 960px) { .art__grid { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-top: 28px; } .toc { position: static; } }
  @media (max-width: 600px) {
    .art__head { padding-top: 28px; }
    .art h1 { font-size: 1.85rem; }
    .art__lead { font-size: 1.05rem; }
    .art__cover { border-radius: 16px; max-height: 260px; }
    .prose { font-size: 1.02rem; line-height: 1.7; }
    .prose :global(h2) { font-size: 1.35rem; }
    .prose :global(h3) { font-size: 1.12rem; }
    .prose :global(th), .prose :global(td) { padding: 8px 10px; font-size: .9rem; }
    .toc > div { display: none; }
    .toc .btn { justify-self: start; }
    .cta, .author { flex-direction: column; align-items: flex-start; }
  }
</style>
