---
import Icon from './Icon.astro';
import { gallery } from '../data/gallery';
import { site } from '../data/site';
---
<div class="gal">
  {gallery.map((p, i) => (
    <button class={`gal__item${p.wide ? ' gal__item--wide' : ''}`} data-index={i} aria-label={`Uvećaj: ${p.alt}`}>
      <img src={p.src} alt={p.alt} loading="lazy" />
      {p.caption && <span class="gal__cap">{p.caption}</span>}
    </button>
  ))}
  <a class="gal__item gal__ig" href={site.instagram} target="_blank" rel="noopener">
    <Icon name="instagram" size={36} />
    <strong>Još fotografija</strong>
    <span>{site.instagramHandle}</span>
  </a>
</div>

<dialog class="lb" aria-label="Fotografija">
  <button class="lb__close" aria-label="Zatvori"><Icon name="close" /></button>
  <img alt="" />
  <p class="lb__cap"></p>
</dialog>

<script>
  import { gallery } from '../data/gallery';
  const dlg = document.querySelector<HTMLDialogElement>('.lb');
  const img = dlg?.querySelector('img');
  const cap = dlg?.querySelector<HTMLElement>('.lb__cap');
  document.querySelectorAll<HTMLButtonElement>('.gal__item[data-index]').forEach((b) =>
    b.addEventListener('click', () => {
      const p = gallery[Number(b.dataset.index)];
      if (!dlg || !img || !cap) return;
      img.src = p.src;
      img.alt = p.alt;
      cap.textContent = p.caption ?? '';
      dlg.showModal();
    }),
  );
  dlg?.querySelector('.lb__close')?.addEventListener('click', () => dlg.close());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  .gal { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); grid-auto-rows: 260px; gap: 14px; }
  .gal__item { position: relative; border: 0; padding: 0; border-radius: var(--radius); overflow: hidden; cursor: zoom-in; background: var(--surface-2); }
  .gal__item--wide { grid-column: span 2; }
  .gal__item img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .gal__item:hover img { transform: scale(1.04); }
  .gal__cap { position: absolute; left: 12px; bottom: 12px; background: rgba(15,42,68,.75); color: #fff; font-size: 0.85rem; font-weight: 700; padding: 6px 12px; border-radius: 999px; }
  .gal__ig { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; text-decoration: none; cursor: pointer;
    background: linear-gradient(140deg, var(--orange), var(--red)); color: #fff; }
  .gal__ig span { opacity: .9; }
  .lb { border: 0; padding: 0; background: transparent; max-width: min(92vw, 1100px); }
  .lb::backdrop { background: rgba(10, 20, 35, .85); }
  .lb img { max-height: 82vh; width: auto; margin: 0 auto; border-radius: 14px; }
  .lb__cap { color: #fff; text-align: center; margin-top: 10px; }
  .lb__close { position: fixed; top: 16px; right: 16px; background: #fff; border: 0; border-radius: 50%; width: 44px; height: 44px; display: grid; place-items: center; cursor: pointer; }
  @media (max-width: 600px) { .gal__item--wide { grid-column: auto; } }
</style>
