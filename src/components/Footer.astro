---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { workshops } from '../data/workshops';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="confetti-line"></div>
  <div class="wrap ftr__grid">
    <div>
      <img src="/img/logo.png" alt="Lumi Kids Studio" width="447" height="180" class="ftr__logo" />
      <p class="ftr__lead">Kreativno-edukativni programi za decu, po porudžbini. Vi nam kažete šta želite — mi osmislimo i isporučimo.</p>
    </div>
    <div>
      <h4>Radionice</h4>
      <ul>{workshops.map((w) => <li><a href={`/radionice/${w.slug}`}>{w.name}</a></li>)}</ul>
    </div>
    <div>
      <h4>Kontakt</h4>
      <ul class="ftr__contact">
        <li><Icon name="map" size={18} /> {site.serviceArea}</li>
        {site.phone && <li><Icon name="phone" size={18} /> <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>}
        {site.email && <li><Icon name="mail" size={18} /> <a href={`mailto:${site.email}`}>{site.email}</a></li>}
        <li><Icon name="instagram" size={18} /> <a href={site.instagram} rel="noopener" target="_blank">{site.instagramHandle}</a></li>
      </ul>
      <a href="/#upit" class="btn btn--accent ftr__cta">Pošaljite upit</a>
    </div>
  </div>
  <div class="wrap ftr__bottom">© {year} {site.name} · {site.city}</div>
</footer>

<style>
  .ftr { background: var(--brand-deep); color: #d6e4f0; margin-top: 0; }
  .ftr__grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px; padding-top: 56px; padding-bottom: 40px; }
  .ftr__logo { height: 64px; width: auto; margin-bottom: 16px; background: #fff; border-radius: 14px; padding: 6px 10px; }
  .ftr__lead { max-width: 360px; }
  .ftr h4 { color: #fff; font-size: 1rem; margin-bottom: 14px; }
  .ftr ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .ftr a { color: #fff; text-decoration: none; }
  .ftr a:hover { text-decoration: underline; }
  .ftr__contact li { display: flex; gap: 10px; align-items: center; }
  .ftr__cta { margin-top: 20px; padding: 10px 20px; }
  .ftr__bottom { border-top: 1px solid rgba(255,255,255,.12); padding-top: 20px; padding-bottom: 28px; font-size: 0.9rem; color: #9fb6cc; }
  @media (max-width: 820px) { .ftr__grid { grid-template-columns: 1fr; gap: 28px; } }
</style>
