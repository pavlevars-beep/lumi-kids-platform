{
  "name": "lumi-kids-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name lumi-kids-studio",
    "db:migrate": "wrangler d1 migrations apply lumi-kids --remote",
    "db:migrate:local": "wrangler d1 migrations apply lumi-kids --local"
  },
  "dependencies": {
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261106.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  }
}
